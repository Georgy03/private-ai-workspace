# Variables for the Railway services (set them in Railway, never in a file in the repository).
# Real values: secrets stay in Railway's variables and in the AWS and provider consoles.

# ---- both services ----
# The pooled Neon address and this service's own login: prism_api for the api, prism_worker for the worker.
DATABASE_URL=postgresql://prism_api:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
# DATABASE_CA_FILE is already set in the image (the system certificates). ALLOW_INSECURE must NOT be set.
OAUTH_STATE_KEY=            # base64, 32+ bytes: openssl rand -base64 32 (the same on both services)
OAUTH_REDIRECT_URI=https://YOUR-API-DOMAIN/oauth/callback
# AWS access for the token store only: an IAM user (or role) allowed just the connector-token-keys
# policy in infra/iam.tf. Not the provisioner's.
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Connectors you offer (each pair is optional; a connector without its pair is not offered).
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
DROPBOX_CLIENT_ID=
DROPBOX_CLIENT_SECRET=
DOCUSIGN_CLIENT_ID=
DOCUSIGN_CLIENT_SECRET=
DOCUSIGN_ENVIRONMENT=production
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
QUICKBOOKS_ENVIRONMENT=production
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=

# ---- api only ----
COGNITO_ISSUER=https://cognito-idp.REGION.amazonaws.com/POOL_ID
COGNITO_CLIENT_ID=
# PORT is given by Railway; the API listens on it. Do not set BIND.

# ---- api only, and only when open sign-up is switched on (self_serve_firms in infra, see infra/README.md) ----
# The prism_prov login: the only database login that may create a firm. Leave it unset to keep sign-up closed.
# ONBOARDING_DATABASE_URL=postgresql://prism_prov:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require
